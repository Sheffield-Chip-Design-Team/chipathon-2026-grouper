CAPI=2:

name: sharc:comms_ip:ahb_qspi_directed:0.0.1
description: Simple directed cocotb testbench for ahb_qspi using Verilator

filesets:
  rtl:
    depend:
      - sharc:comms_ip:ahb_qspi:0.0.1

  aperture_rtl:
    files:
      - ../../rtl/interconnect_ss.sv: {file_type: systemVerilogSource}

targets:
  default:
    flow: sim
    flow_options:
      tool: verilator
      cocotb_module: hw.tb.qspi.test_qspi
      verilator_options:
        - -Wno-TIMESCALEMOD
        - --sv
        - --trace
        - --trace-fst
        - --coverage
      run_options:
        - --trace
    filesets: [rtl]
    toplevel: ahb_qspi

  stream:
    flow: sim
    flow_options:
      tool: verilator
      cocotb_module: hw.tb.qspi.test_qspi_stream
      verilator_options:
        - -Wno-TIMESCALEMOD
        - --sv
        - --trace
        - --trace-fst
      run_options:
        - --trace
    filesets: [rtl]
    toplevel: qspi

  aperture:
    flow: sim
    flow_options:
      tool: verilator
      cocotb_module: hw.tb.qspi.test_qspi_aperture
      verilator_options:
        - -Wno-TIMESCALEMOD
        - --sv
        - --trace
        - --trace-fst
      run_options:
        - --trace
    filesets: [aperture_rtl]
    toplevel: interconnect_ss
