CAPI=2:
name: sharc:soc_ip:grouper_soc_directed:0.0.1
description: Directed cocotb top-level testbench for the Grouper SoC (hw/tb/top/test_soc.py)

# Drives grouper_soc_top, so the top-level input synchronisers are in the
# path - the SystemVerilog testbench drives digital_ss, which sits below them.
#
#   FW_TEST=gpio fusesoc run --no-export sharc:soc_ip:grouper_soc_directed
#   FW_TEST=gpio fusesoc run --no-export --target=trace sharc:soc_ip:grouper_soc_directed

# FW_TEST picks the firmware top level from sw/tests; FW_DEBUG=1 builds it
# with -DDEBUG. The debug and trace targets set FW_DEBUG for you, because
# debug()/debug_str() are no-ops without it and would never reach ahb_debug.
# The debug variant passes --debug on the command line rather than setting

# The ROM image is whichever pre_build hook ran: both build scripts publish
# their code.hex to the work root, which is the cwd rom_ss.sv's $readmemh
# resolves against. So the target selects the image -
#
#   default/boot         the ROM bootloader        (sw/scripts/build_bootloader.sh)
#   fw_rom/debug/trace   the application firmware  (sw/scripts/build_fw.sh)
#
# FW_LINK=ram builds the application for RAM instead of ROM, which is the form
# the bootloader loads over the UART. The SoC's ROM is only 1 KiB, so anything
# bigger than the bootloader has to go that way - which is why the bootloader
# flow, not the ROM-linked one, is the default.

scripts:
  build_fw:
    cmd: [bash, -c, '"exec $${FUSESOC_REPO_ROOT:-../../..}/sw/scripts/build_fw.sh"']
  build_fw_debug:
    cmd: [bash, -c, '"exec $${FUSESOC_REPO_ROOT:-../../..}/sw/scripts/build_fw.sh --debug"']
  build_bootloader:
    cmd: [bash, -c, '"exec $${FUSESOC_REPO_ROOT:-../../..}/sw/scripts/build_bootloader.sh --baud $${FW_BAUD:-625000}"']
  # The image the bootloader is given, linked for RAM rather than ROM. FW_TEST
  # defaults to a self-checking test rather than sw/src/main.c, which waits for
  # console input and so would never report a result on its own. Both defaults
  # give way to the environment.
  build_fw_ram:
    cmd: [bash, -c, '"FW_TEST=$${FW_TEST:-fibonnaci} exec $${FUSESOC_REPO_ROOT:-../../..}/sw/scripts/build_fw.sh --link ram --baud $${FW_BAUD:-625000}"']
  # Marks the work root so test_soc.py picks the backdoor test over the UART
  # one. A hook runs with the work root as cwd, and each target has its own, so
  # this cannot leak into another target's run. Same signal-by-file-presence
  # idiom as fw_id.txt and cpu.trace.
  mark_preload:
    cmd: [bash, -c, '"echo 1 > ram_preload.txt"']

parameters:
  DEBUG_PERIPH:
    datatype: bool
    paramtype: vlogdefine
    description: Instantiate the ahb_debug peripheral. Pair with FW_DEBUG=1.
    default: false
  CPU_TRACE:
    datatype: bool
    paramtype: vlogdefine
    description: Enable picorv32's instruction trace. Needs DEBUG_PERIPH too.
    default: false

filesets:
  rtl:
    depend:
      - sharc:soc_ip:grouper_soc:0.0.1

# Deliberately no YAML merge key - prevents firmware build re-running
targets:
  # The ROM holds the bootloader and the image is written straight into the
  # SRAM macros rather than sent over the UART - ~18 minutes of wall clock
  # becomes a few seconds, which is what makes this a usable default. The bank
  # switch still happens for real, driven by a 'B' on the UART, so the part
  # most likely to be broken stays covered; only the bulk transfer and the
  # bootloader's 'W' path are skipped, and `boot` still covers those.
  #
  # --public-flat-rw is what makes the macro arrays reachable over VPI. It
  # applies to this target only: it makes every signal public, which costs
  # simulation speed and is not something the other targets should pay for -
  # hence the flow options written out here rather than shared through
  # &flow_opts below.
  #
  # --coverage is load bearing here too, and not for coverage: without it
  # verilator flattens ram_ss's gen_macro_ram generate block away, the
  # gen_sram[j].u_wrapper.u_sram_macro path stops existing, and the preload
  # cannot find the arrays. Removing it fails the test with exactly that
  # message out of ram_lane_arrays().
  default:
    description: The ROM bootloader boots a RAM-linked image preloaded into the SRAM macros.
    filesets: [rtl]
    flow: sim
    flow_options:
      tool: verilator
      cocotb_module: hw.tb.top.test_soc
      verilator_options:
        - -Wno-TIMESCALEMOD
        - -Wno-fatal
        - --sv
        - --trace
        - --coverage
        - --public-flat-rw
      run_options:
        - --trace
    toplevel: grouper_soc_top
    hooks:
      pre_build: [build_fw_ram, build_bootloader, mark_preload]

  # The application firmware in the ROM, with no bootloader in the picture -
  # what `default` was before the preload flow took that slot. Only firmware
  # that fits the 1 KiB ROM can run this way; anything larger needs `default`
  # or `boot`.
  fw_rom:
    description: A ROM-linked application image, booted directly from the ROM.
    filesets: [rtl]
    flow: sim
    flow_options: &flow_opts
      tool: verilator
      cocotb_module: hw.tb.top.test_soc
      verilator_options:
        - -Wno-TIMESCALEMOD
        - -Wno-fatal
        - --sv
        - --trace
        - --coverage
      run_options:
        - --trace
    toplevel: grouper_soc_top
    hooks:
      pre_build: [build_fw]

  debug:
    description: As fw_rom, plus debug firmware and the ahb_debug peripheral.
    filesets: [rtl]
    flow: sim
    flow_options: *flow_opts
    toplevel: grouper_soc_top
    parameters:
      - DEBUG_PERIPH=true
    hooks:
      pre_build: [build_fw_debug]

  # The ROM holds the bootloader, and test_bootloader_load in
  # hw/tb/top/test_soc.py plays the host: it loads the RAM-linked firmware.bin
  # over the UART, reads it back, sends the bank switch and then scores the
  # image that boots. This is how firmware larger than the 1 KiB ROM runs at
  # all.
  #
  # Two hooks, in order - both publish a code.hex to the work root and the
  # bootloader has to land last, because that is the one the ROM loads. The
  # application build leaves firmware.bin there for the testbench to send.
  #
  # Both are built at 625000 baud (FW_BAUD to change it): the load is ~2.4 KiB
  # of UART traffic, which costs 1.3 s of simulated time at 19200 and 40 ms
  # here. sw/src/config.h's clock makes that an exact divisor.
  boot:
    description: The ROM holds the bootloader, which is fed a RAM-linked image over the UART.
    filesets: [rtl]
    flow: sim
    flow_options: *flow_opts
    toplevel: grouper_soc_top
    hooks:
      pre_build: [build_fw_ram, build_bootloader]

  # CPU_TRACE turns on picorv32's trace port via cpu_ss's ENABLE_TRACE, but
  # ahb_debug is what actually writes cpu.trace - hence DEBUG_PERIPH as well.
  # hw/tb/top/trace_decode.py turns the result into cpu_trace.dis.
  trace:
    description: As debug, plus the CPU instruction trace decoded to cpu_trace.dis.
    filesets: [rtl]
    flow: sim
    flow_options: *flow_opts
    toplevel: grouper_soc_top
    parameters:
      - DEBUG_PERIPH=true
      - CPU_TRACE=true
    hooks:
      pre_build: [build_fw_debug]
