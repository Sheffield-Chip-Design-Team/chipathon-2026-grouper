CAPI=2:

name: sharc:comms_ip:ahb_spi_m:0.0.1
description: AHB-Lite wrapped SPI master (RTL only, no testbench)

filesets:
  rtl:
    files:
      - spi_m_tx.sv:                  {file_type: systemVerilogSource}
      - spi_m_rx.sv:                  {file_type: systemVerilogSource}
      - spi_m_core.sv:                {file_type: systemVerilogSource}
      - ahb_spi_m.sv:                 {file_type: systemVerilogSource}
    depend:
      - sharc:common_ip:common:0.0.1
      - sharc:amba_ip:ahb3lite_pkg:0.0.1

targets:
  default: &rtl
    filesets: [rtl]
    toplevel: ahb_spi_m

  lint:
    <<: *rtl
    description: Verilator lint-only check (no simulation)
    flow: sim
    flow_options:
      tool: verilator
      mode: lint-only
      verilator_options:
        - --sv
        - -Wall
        - -Wno-fatal
