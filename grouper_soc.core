CAPI=2:
name: sharc:soc_ip:grouper_soc:0.0.1
description: RISC-V 32IM SoC with UART, SPI and GPIO

parameters:
  DEBUG_PERIPH:
    datatype: bool
    paramtype: vlogdefine
    description: >
      Instantiate the ahb_debug peripheral in periph_ss.sv. Must be paired
      with firmware built with -DDEBUG (build_fw_debug script) - otherwise
      debug()/debug_str() compile to no-ops and never reach it.
    default: false
  CPU_TRACE:
    datatype: bool
    paramtype: vlogdefine
    description: >
      Build cpu_ss with picorv32's instruction trace and enable the trace
      capture in ahb_debug (needs DEBUG_PERIPH too). Records are written to
      CPU_TRACE_FILE (default cpu.trace) for picorv32's showtrace.py.
      Consumed with `ifdef, so only list it in targets that want it on -
      DEBUG_PERIPH is handled the same way.
    default: false

# These build sw/src/main.c as the firmware top level. To run one of the
# tests in sw/tests instead, set FW_TEST 
# e.g. FW_TEST=hello_world fusesoc run --target=tb_top_debug grouper_soc
# `sw/scripts/build_fw.sh --list` shows what is available.
scripts:
  build_fw:
    cmd: [bash, -c, '"exec $${FUSESOC_REPO_ROOT:-../../..}/sw/scripts/build_fw.sh"']
  build_fw_debug:
    cmd: [bash, -c, '"exec $${FUSESOC_REPO_ROOT:-../../..}/sw/scripts/build_fw.sh --debug"']

filesets:
  rtl:
    depend:
      - sharc:common_ip:common:0.0.1
      - sharc:amba_ip:ahb3lite_pkg:0.0.1
      - yosys:cpu_ip:picorv32:1.0.0
      - sharc:comms_ip:ahb_uart:0.0.1
      - sharc:comms_ip:ahb_spi_s:0.0.1

    files:
      - hw/rtl/interconnect/ahb_debug.sv:                 {file_type: systemVerilogSource}
      - hw/rtl/interconnect/ahb_conn.sv:                  {file_type: systemVerilogSource}
      - hw/rtl/interconnect/ahb_conn_buff.sv:             {file_type: systemVerilogSource}
      - hw/rtl/interconnect/ahb_stub_slave.sv:            {file_type: systemVerilogSource}
      - hw/rtl/ahb_interconnect_ss.sv:                    {file_type: systemVerilogSource}

      - hw/rtl/memory/ahb_rom.sv:                         {file_type: systemVerilogSource}
      - hw/rtl/memory/ahb_ram.sv:                         {file_type: systemVerilogSource}
      
      - hw/rtl/io_ss.sv:                                  {file_type: systemVerilogSource}
      - hw/rtl/cpu_ss.sv:                                 {file_type: systemVerilogSource}
      - hw/rtl/periph_ss.sv:                              {file_type: systemVerilogSource}
      - hw/rtl/digital_ss.sv:                             {file_type: systemVerilogSource}
      - hw/rtl/grouper_soc_top.sv:                        {file_type: systemVerilogSource}
  sw:
    files:
      - sw/code.vmem:                                     {file_type: systemVerilogSource, is_include_file: true}
      - sw/code.hex:                                      {file_type: systemVerilogSource, is_include_file: true}
      - sw/fw_id.svh:                                     {file_type: systemVerilogSource, is_include_file: true}
  tb:
    files:
      - hw/tb/top/grouper_soc_hello_tb.sv:                       {file_type: systemVerilogSource}

targets:
  default: &sim
    description: Default.
    filesets:
      - rtl
      - sw
    toplevel: grouper_soc_hello_top

  tb_top:
    <<: *sim
    description: Grouper SoC top-level simulation.
    flow: sim
    flow_options:
      tool: verilator
      verilator_options:
        - -Wno-TIMESCALEMOD
        - -Wno-fatal
        - --sv
        - --trace
        - --trace-fst
        - --binary
        - --coverage
    filesets_append:
      - tb
    toplevel: grouper_soc_hello_tb
    hooks:
      pre_build: [build_fw]

  tb_top_debug:
    <<: *sim
    description: Grouper SoC top-level simulation (debug firmware + ahb_debug instantiated).
    flow: sim
    flow_options:
      tool: verilator
      verilator_options:
        - -Wno-TIMESCALEMOD
        - -Wno-fatal
        - --sv
        - --trace
        - --trace-fst
        - --binary
        - --coverage
    filesets_append:
      - tb
    toplevel: grouper_soc_hello_tb
    parameters:
      - DEBUG_PERIPH=true
    hooks:
      pre_build: [build_fw_debug]

  tb_top_trace:
    <<: *sim
    description: Grouper SoC top-level simulation (as tb_top_debug, plus the CPU instruction trace).
    flow: sim
    flow_options:
      tool: verilator
      verilator_options:
        - -Wno-TIMESCALEMOD
        - -Wno-fatal
        - --sv
        - --trace
        - --trace-fst
        - --binary
        - --coverage
    filesets_append:
      - tb
    toplevel: grouper_soc_hello_tb
    parameters:
      - DEBUG_PERIPH=true
      - CPU_TRACE=true
    hooks:
      pre_build: [build_fw_debug]